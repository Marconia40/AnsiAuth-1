# =============================================================================
# AnsiAuth backend configuration
# Copy this file to `.env` (inside backend/) and adjust the values for your
# environment. Every setting can also be supplied via a normal shell
# environment variable, which takes precedence over this file.
#
# The values below are meant for LOCAL DEVELOPMENT against the `db` and
# `redis` services of the root docker-compose.yml. Production installs get
# their own generated .env from install.sh. The variables that only
# docker compose reads (POSTGRES_PASSWORD, REDIS_PASSWORD, ...) live in the
# root .env.example.
# =============================================================================

# ── Execution mode ───────────────────────────────────────────────────────────
# "mock"  — no real Ansible playbooks are dispatched (used by tests and local
#           UI development).
# "real"  — playbooks and SSH sessions run against the devices registered
#           through the web UI or the API.
EXECUTION_MODE=mock

# ── Secrets (REQUIRED) ───────────────────────────────────────────────────────
# Encrypts device passwords and private keys at rest. The app refuses to start
# without a valid key, and changing it makes stored credentials unreadable
# (see docs/runbooks/fernet-key-rotation.md).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your_generated_fernet_key_here

# Signs the JWT access tokens. Independent from FERNET_KEY: never reuse one
# for the other (see docs/runbooks/jwt-secret-rotation.md).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_generated_jwt_secret_here

# ── Database ─────────────────────────────────────────────────────────────────
# SQLAlchemy URL. PostgreSQL 16 is the supported database: docker-compose,
# install.sh and the test suite all use it, and row-level security (see
# docs/runbooks/rls-activacion.md) only exists there. When unset, the code
# falls back to a SQLite file at backend/app/db/app.db, fine only for quick
# local trials. This value points at the `db` service of docker-compose.yml.
DATABASE_URL=postgresql+psycopg://ansiauth:ansiauth_dev_password@localhost:5432/ansiauth

# ── Celery + Redis ───────────────────────────────────────────────────────────
# Broker/result backend for Celery and store for device locks, the global SSH
# semaphore and the per-device command rate limit. Celery always uses it
# (default: redis://localhost:6379/0); locks and the per-device rate limit
# fall back to in-process primitives when Redis is unreachable. The `redis` service of
# docker-compose.yml requires a password (REDIS_PASSWORD in the root .env).
REDIS_URL=redis://:redis_dev_password_change_me@localhost:6379/0

# Run Celery tasks inline inside the API request instead of sending them to a
# worker. Handy to try the API without starting `celery worker`; the test
# suite turns it on automatically. Default: false.
# CELERY_TASK_ALWAYS_EAGER=false

# ── First-run admin bootstrap ────────────────────────────────────────────────
# Used only when the DB contains no active super-admin yet. After the first
# super-admin is created, these values are ignored.
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=change_me_to_a_strong_password_min_12_chars

# ── Token lifetimes and session hardening ────────────────────────────────────
# Access token lifetime in minutes. Default: 20
ACCESS_TOKEN_EXPIRE_MINUTES=20

# Refresh token lifetime in minutes. Default: 240 (4 hours)
REFRESH_TOKEN_EXPIRE_MINUTES=240

# Idle timeout: a refresh token not rotated within this many minutes is
# rejected and its session chain revoked. Default: 15
# REFRESH_TOKEN_IDLE_MINUTES=15

# Absolute session lifetime since login, regardless of activity. Default: 2
# SESSION_ABSOLUTE_MAX_HOURS=2

# Lifetime of the step-up re-authentication token required by destructive
# operations (1-15 minutes). Default: 5
# ELEVATED_TOKEN_EXPIRE_MINUTES=5

# ── Cookies ──────────────────────────────────────────────────────────────────
# Refresh-token cookie attributes.
#
# The code defaults to COOKIE_SECURE=true so deployments behind TLS work
# without extra flags. Browsers refuse Secure cookies over plain HTTP, so local
# development without TLS needs false, otherwise `/auth/login` appears to
# succeed but the cookie is never stored. Set it back to true behind HTTPS.
COOKIE_SECURE=false

# SameSite policy: "strict" | "lax" | "none". Default: strict.
# Use "none" only if the frontend is hosted on a different registrable domain
# than the API; "none" requires COOKIE_SECURE=true.
COOKIE_SAMESITE=strict

# ── CORS ─────────────────────────────────────────────────────────────────────
# Allowed origins for browser clients. Accepts either:
#   - a JSON list:  CORS_ORIGINS=["https://app.example.com","https://admin.example.com"]
#   - a comma-separated string: CORS_ORIGINS=https://app.example.com,https://admin.example.com
# Default: http://localhost:3000,http://127.0.0.1:3000 (dev-friendly)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Rate limiting (per minute) ───────────────────────────────────────────────
# Unauthenticated requests per IP. Default: 20
# RATE_LIMIT_PER_IP=20
# Authenticated requests per user. Default: 200
# RATE_LIMIT_PER_USER=200
# Login attempts per IP. Default: 5
# RATE_LIMIT_LOGIN=5

# ── Ansible timeouts (seconds) ───────────────────────────────────────────────
# Passed to ansible-runner on every playbook run. Devices with large configs
# (many VLANs / routes / interfaces) can need more. Default: 60 each
# (docker-compose.yml raises them to 300 / 300 / 120).
# ANSIBLE_TIMEOUT=60
# ANSIBLE_PERSISTENT_COMMAND_TIMEOUT=60
# ANSIBLE_PERSISTENT_CONNECT_TIMEOUT=60

# ── Direct SSH sessions (devices with auth_method="key") ─────────────────────
# Connection timeout. Default: 15
# SSH_DIRECT_CONNECT_TIMEOUT=15
# Timeout for one SSH session, including every command sent in it. Default: 60
# SSH_DIRECT_COMMAND_TIMEOUT=60
# Seconds stdin stays open after the last command so the device can flush
# large outputs before the session closes. Default: 5.0
# SSH_DIRECT_DRAIN_DELAY=5.0

# ── Device locks and SSH concurrency ─────────────────────────────────────────
# Per-device lock: short TTL renewed by a background thread while the job
# runs, so a crashed worker frees the device in ~TTL seconds. Defaults: 60/20
# DEVICE_LOCK_TTL_S=60
# DEVICE_LOCK_RENEW_S=20
# How long a job waits for a busy device before failing with "device busy"
# (the device is never touched in that case). Default: 600
# DEVICE_LOCK_WAIT_S=600
# System-wide cap on simultaneous SSH sessions (protects the server against
# bursts). Default: 20
# MAX_CONCURRENT_SSH=20

# ── Background jobs (Celery Beat) ────────────────────────────────────────────
# Minutes between sweeps that recover jobs stuck in "running" whose worker
# died. Default: 5
# ORPHAN_JOB_SWEEP_MIN=5
# A "running" job is only treated as orphaned after this many seconds and
# when its device lock is free. Default: 600
# ORPHAN_JOB_MIN_AGE_S=600
# Periodic re-read of every device. Off by default: devices are read when a
# view shows them, after each change and on demand. Default: false
# SYNC_PERIODIC_ENABLED=false
# Minutes between periodic re-reads (only with SYNC_PERIODIC_ENABLED). Default: 20
# SYNC_STALE_INTERVAL_MIN=20
# A device is re-read when its stored state is older than this. Default: 900
# SYNC_STALE_THRESHOLD_S=900
# Delay between tasks enqueued by the same sweep. Default: 3
# SYNC_STALE_STAGGER_S=3

# ── Audit retention ──────────────────────────────────────────────────────────
# How many days of audit log to keep. Daily purge job at 02:00 UTC. Default: 90
AUDIT_RETENTION_DAYS=90

# ── Background cleanup ───────────────────────────────────────────────────────
# Interval (hours) between sweep runs that purge artifacts on disk, delete
# expired refresh tokens, and trim old login_attempts rows. One pass also
# fires at startup so a long-lived deployment doesn't wait a full interval
# for the first cleanup. Default: 6.
CLEANUP_INTERVAL_HOURS=6

# Days of ansible-runner artifact directories to keep under
# backend/ansible/artifacts/. Each playbook run creates one UUID-named dir;
# they accumulate quickly in busy environments. Default: 30.
ARTIFACT_RETENTION_DAYS=30

# Days of login_attempts history to keep. The lockout window itself is much
# shorter and lives in login_attempt_service — this only trims rows that no
# longer influence rate-limit / lockout decisions. Default: 7.
LOGIN_ATTEMPT_RETENTION_DAYS=7

# ── Observability ────────────────────────────────────────────────────────────
# Set LOG_FORMAT=json to emit structured JSON log lines instead of plain text.
# Each line includes "timestamp", "level", "logger", "message", and any extra
# fields passed as keyword arguments to logger.info/error/etc.
# Default: text (human-readable plain-text format).
# LOG_FORMAT=json

# Expose a Prometheus-compatible /metrics endpoint. When enabled, the endpoint
# is mounted at /metrics and returns HTTP request counters and histograms via
# prometheus-fastapi-instrumentator. Keep this off unless a Prometheus scraper
# is configured to reach the backend directly.
# Default: false.
# METRICS_ENABLED=true

# ── TLS at the app (optional — usually terminated by a reverse proxy) ────────
# Absolute paths to PEM-encoded certificate/key. When SSL_CERTFILE is set,
# the app installs HSTS + HTTPS-redirect middleware (see
# docs/deployment/tls-setup.md).
# SSL_CERTFILE=
# SSL_KEYFILE=

# ── start.py launcher (`python start.py`) ────────────────────────────────────
# Bind address and port. Defaults: 0.0.0.0 / 8000
# HOST=0.0.0.0
# PORT=8000
# Auto-reload on code changes (development only). Default: false
# RELOAD=false
