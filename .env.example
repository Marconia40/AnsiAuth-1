# =============================================================================
# AnsiAuth — variables for docker compose (root of the repository)
# Copy this file to `.env` next to docker-compose.yml:  cp .env.example .env
#
# docker compose reads this file automatically to fill the ${...} references
# in docker-compose.yml. Only the variables listed below reach the containers;
# the rest of the backend settings keep their code defaults (documented in
# backend/.env.example).
#
# Production: install.sh generates its own .env here with random secrets and
# passes it whole to the containers (env_file), so any variable from
# backend/.env.example can be added to it.
# =============================================================================

# ── Secrets (REQUIRED) ───────────────────────────────────────────────────────
# Encrypts device passwords at rest. There is NO default: the backend and the
# worker refuse to start without it, and both must share the same value.
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your_generated_fernet_key_here

# Signs the JWT access tokens. Compose default: an insecure dev placeholder.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_generated_jwt_secret_here

# Password of the first super-admin, created on the first boot only when the
# database has none (minimum 12 characters). The username is "admin".
BOOTSTRAP_ADMIN_PASSWORD=change_me_to_a_strong_password_min_12_chars

# ── Data services ────────────────────────────────────────────────────────────
# PostgreSQL password of the "ansiauth" user. It is only applied when the data
# volume is created: with an existing database, change it with ALTER USER too.
# If you change it, update DATABASE_URL in backend/.env (local backend) and
# the test database URL accordingly.
POSTGRES_PASSWORD=ansiauth_dev_password

# Redis password. Whoever reaches Redis can enqueue Celery tasks without going
# through the API, so in production it must be long and random. It goes inside
# REDIS_URL: use URL-safe characters only, e.g.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=redis_dev_password_change_me

# ── Application ──────────────────────────────────────────────────────────────
# "mock" simulates every device operation (no network access); "real" runs
# Ansible / SSH against the registered devices. Compose default: mock
EXECUTION_MODE=mock

# Secure attribute of the refresh-token cookie. Keep false for plain-HTTP
# local development; set true when the stack is served over HTTPS.
# Compose default: false
COOKIE_SECURE=false

# Address where the API port (8000) is published on the host. 127.0.0.1 when
# the reverse proxy runs on this same host; 0.0.0.0 when it runs elsewhere.
# Compose default: 0.0.0.0
# BACKEND_BIND_ADDRESS=127.0.0.1

# ── Timeouts and locks (backend + worker) ────────────────────────────────────
# See backend/.env.example for the meaning of each one. Compose defaults shown.
# ANSIBLE_TIMEOUT=300
# ANSIBLE_PERSISTENT_COMMAND_TIMEOUT=300
# ANSIBLE_PERSISTENT_CONNECT_TIMEOUT=120
# SSH_DIRECT_COMMAND_TIMEOUT=300
# DEVICE_LOCK_TTL_S=60
# DEVICE_LOCK_RENEW_S=20
# DEVICE_LOCK_WAIT_S=600

# ── Celery Beat (beat service) ───────────────────────────────────────────────
# SYNC_STALE_INTERVAL_MIN=20
# SYNC_STALE_THRESHOLD_S=420
# SYNC_STALE_STAGGER_S=3
