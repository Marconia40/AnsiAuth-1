# =============================================================================
# AnsiAuth frontend configuration
# Copy this file to `.env.local` and adjust the values for your environment.
# NEXT_PUBLIC_* variables are inlined into the browser bundle at build time:
# changing them requires a new `npm run build` (or restarting `npm run dev`).
# =============================================================================

# Base URL of the backend, without the /api/v1 suffix (the client appends it).
# Local development: the API started with uvicorn or docker compose on :8000.
# Behind the Caddy reverse proxy set up by install.sh, use the public URL
# (e.g. https://ansiauth.example.com), since Caddy serves /api/* and the UI
# from the same origin. Default when unset: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
